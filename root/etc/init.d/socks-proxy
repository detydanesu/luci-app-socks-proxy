#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

NAME='socks-proxy'
PROG='/usr/bin/sing-box'
GENERATOR='/usr/libexec/socks-proxy/generate.uc'
RUNDIR='/var/run/socks-proxy'
CONFIG_FILE="$RUNDIR/config.json"

start_service() {
	local enabled
	enabled="$(uci -q get socks-proxy.global.enabled)"
	[ "$enabled" = '1' ] || return 0

	mkdir -p "$RUNDIR"
	if ! "$GENERATOR" > "$CONFIG_FILE.tmp"; then
		logger -t "$NAME" '无法生成 sing-box 配置'
		rm -f "$CONFIG_FILE.tmp"
		return 1
	fi

	if ! "$PROG" check -c "$CONFIG_FILE.tmp" >/tmp/socks-proxy-check.log 2>&1; then
		logger -t "$NAME" "sing-box 配置无效：$(tail -n 1 /tmp/socks-proxy-check.log)"
		rm -f "$CONFIG_FILE.tmp" /tmp/socks-proxy-check.log
		return 1
	fi

	rm -f /tmp/socks-proxy-check.log
	mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
	chmod 600 "$CONFIG_FILE"

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONFIG_FILE"
	# OpenClash returns packets whose socket group is nogroup (GID 65534).
	# Keep UID 0 for compatibility while changing only the primary group.
	procd_set_param user root
	procd_set_param group nogroup
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile='65535 65535'
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'socks-proxy'
}

reload_service() {
	stop
	start
}
