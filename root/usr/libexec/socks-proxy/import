#!/bin/sh

IMPORTER='/usr/libexec/socks-proxy/import.uc'
mode="$1"

run_import() {
	result_file="$(mktemp /tmp/socks-proxy-import-result.XXXXXX)" || {
		echo '{"success":false,"error":"无法创建导入结果临时文件"}'
		return 1
	}

	/usr/bin/ucode "$@" >"$result_file"
	rc="$?"

	if [ "$rc" -eq 0 ] && grep -q '"success"[[:space:]]*:[[:space:]]*true' "$result_file"; then
		reload_error="$(/etc/init.d/socks-proxy reload 2>&1)"
		if [ "$?" -ne 0 ]; then
			logger -t socks-proxy "导入成功但本插件服务重载失败：$(printf '%s' "$reload_error" | tail -n 1)"
			rm -f "$result_file"
			echo '{"success":false,"error":"节点已导入，但本插件服务重载失败，请查看服务状态和日志"}'
			return 1
		fi
	fi

	if [ -s "$result_file" ]; then
		cat "$result_file"
	else
		echo '{"success":false,"error":"导入程序没有返回结果"}'
	fi
	rm -f "$result_file"
	return "$rc"
}

case "$mode" in
	file)
	input="$2"
	replace_existing="$3"
	[ "$input" = '/tmp/socks-proxy-import.txt' ] || {
		echo '{"success":false,"error":"无效的导入文件"}'
		exit 2
	}
	[ -f "$input" ] || {
		echo '{"success":false,"error":"导入文件不存在"}'
		exit 2
	}
	trap 'rm -f /tmp/socks-proxy-import.txt' EXIT INT TERM
	run_import -D mode=file -D "replace_existing=$replace_existing" \
		-D "input_path=$input" "$IMPORTER"
	;;

	subscription|subscription-url)
	section="$2"
	case "$section" in
		''|*[!A-Za-z0-9_]*)
			echo '{"success":false,"error":"无效的订阅配置"}'
			exit 2
		;;
	esac

	if [ "$mode" = 'subscription-url' ]; then
		url="$3"
	else
		url="$(uci -q get "socks-proxy.$section.url")"
	fi
	[ -n "$url" ] || {
		echo '{"success":false,"error":"订阅地址不能为空"}'
		exit 2
	}
	case "$url" in
		http://*|https://*) ;;
		*)
			echo '{"success":false,"error":"订阅地址仅支持 HTTP 和 HTTPS"}'
			exit 2
		;;
	esac

	tmp="$(mktemp /tmp/socks-proxy-subscription.XXXXXX)" || exit 1
	trap 'rm -f "$tmp"' EXIT INT TERM
	if ! /usr/bin/curl --globoff --location --silent --show-error --fail \
		--connect-timeout 10 --max-time 45 --output "$tmp" -- "$url"; then
		echo '{"success":false,"error":"无法下载订阅"}'
		exit 1
	fi

	run_import -D mode=subscription -D "section=$section" \
		-D "input_path=$tmp" "$IMPORTER"
	;;

	*)
	echo '{"success":false,"error":"导入命令参数无效"}'
	exit 2
	;;
esac
